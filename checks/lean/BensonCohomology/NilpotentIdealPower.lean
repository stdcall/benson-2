import Mathlib.RingTheory.Ideal.Operations

/-!
# Lemma 5.3.6: an ideal generated by nilpotents `x_i` with `x_i^(n_i) = 0`
# has `J^n = 0` for `n = ∑ n_i`

Benson, *Representations and Cohomology II*, Section 5.3, Lemma 5.3.6
(`lem:nilpotent-growth`): if `A` is a finitely generated commutative graded
ring, the nilpotent elements form an ideal `J`; "since `A` is Noetherian, `J`
is finitely generated by nilpotent elements `x_i`.  If `x_i^(n_i) = 0` then
`J^n = 0` with `n = ∑_i n_i`."

Formalised here, for any commutative semiring `R` (the book's `A`), a
non-empty finite family `x_i`, `i ∈ s`, of elements with `x_i ^ n_i = 0`:

* `span_pow_sum_eq_bot`: `(span {x_i : i ∈ s}) ^ (∑_(i ∈ s) n_i) = ⊥`, by
  induction on `s`: `span {x_i} ^ n_i = span {x_i ^ n_i} = ⊥` and
  `(I ⊔ J) ^ (m + n) ≤ I ^ m ⊔ J ^ n`;
* `isNilpotent_span`: hence the ideal is nilpotent, with this exponent.

Notation: `x i` = the book's `x_i`, `n i` = `n_i`, `s` indexes the
generators.  Hypotheses: commutativity (the book's rings are graded
commutative; for odd `p` the book works with `H^ev`, see the Remark after
Proposition 5.3.1) and `s` non-empty (for `J = 0` with no generators the
book's `n = 0` would give `J^0 = A`).  Not covered: that the nilpotent
elements form a finitely generated ideal (Noetherian), and the equality
`γ(A) = γ(A/J)` of growth rates; these are checked on examples in
`checks/sage/chapter-5a.py` (Lemma 5.3.6).
-/

namespace BensonCohomology.NilpotentIdealPower

open Ideal

variable {R : Type*} [CommSemiring R]

theorem span_pow_sum_eq_bot {ι : Type*} [DecidableEq ι] (x : ι → R)
    (n : ι → ℕ) (s : Finset ι) (hs : s.Nonempty)
    (hx : ∀ i ∈ s, x i ^ n i = 0) :
    (Ideal.span (x '' (s : Set ι))) ^ (∑ i ∈ s, n i) = ⊥ := by
  induction hs using Finset.Nonempty.cons_induction with
  | singleton i =>
    have h := hx i (Finset.mem_singleton_self i)
    simp [Ideal.span_singleton_pow, h]
  | cons j s hj hs ih =>
    have hxj : x j ^ n j = 0 := hx j (Finset.mem_cons_self j s)
    have hxs : ∀ i ∈ s, x i ^ n i = 0 :=
      fun i hi => hx i (Finset.mem_cons.mpr (Or.inr hi))
    have hspan : Ideal.span (x '' ((Finset.cons j s hj : Finset ι) : Set ι)) =
        Ideal.span {x j} ⊔ Ideal.span (x '' (s : Set ι)) := by
      rw [Finset.coe_cons, Set.image_insert_eq, Ideal.span_insert]
    rw [hspan, Finset.sum_cons]
    refine le_bot_iff.mp (le_trans Ideal.sup_pow_add_le_pow_sup_pow ?_)
    rw [Ideal.span_singleton_pow, hxj, ih hxs]
    simp

theorem isNilpotent_span {ι : Type*} [DecidableEq ι] (x : ι → R)
    (n : ι → ℕ) (s : Finset ι) (hs : s.Nonempty)
    (hx : ∀ i ∈ s, x i ^ n i = 0) :
    IsNilpotent (Ideal.span (x '' (s : Set ι))) :=
  ⟨∑ i ∈ s, n i, span_pow_sum_eq_bot x n s hs hx⟩

end BensonCohomology.NilpotentIdealPower

#print axioms BensonCohomology.NilpotentIdealPower.span_pow_sum_eq_bot
#print axioms BensonCohomology.NilpotentIdealPower.isNilpotent_span
