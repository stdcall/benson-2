import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.GroupTheory.PGroup
import Mathlib.GroupTheory.Perm.Cycle.Type

/-!
# Theorem 6.6.1, proof: the conical contraction `A ≤ A P₀ ≥ P₀`

Benson, *Representations and Cohomology II*, Section 6.6, Theorem 6.6.1
(`th:quillen-equivalence`, Quillen, Thévenaz): the inclusion
`𝒜_p(G) ↪ 𝒮_p(G)` is a `G`-homotopy equivalence.  The proof reduces, by
Theorem 6.4.2 and Quillen's Lemma 6.5.2, to the conical contractibility of
`𝒜_p(P)^H` for a non-trivial `p`-subgroup `P` normalised by `H`: with
`P₀ = Ω₁ Z(P)`, the subgroup of the centre of `P` generated by its elements
of order `p`, "for any non-trivial elementary abelian subgroup `A ≤ P`
normalised by `H`, we have `A ≤ ⟨A, P₀⟩ ≥ P₀`.  Since `⟨A, P₀⟩` is elementary
abelian, this means that `𝒜_p(P)^H` is conically contractible."  The two
group-theoretic facts used are formalised here:

* `sup_comm_of_central` and `sup_pow_eq_one_of_central`
  (`sup_elementaryAbelian`): if `A` is a subgroup whose elements commute
  and satisfy `a^p = 1`, and `Z` is a subgroup of the centre whose elements
  satisfy `z^p = 1`, then the elements of `A ⊔ Z = ⟨A, Z⟩` commute and satisfy
  `x^p = 1`: `⟨A, P₀⟩` is elementary abelian (for `Z = P₀`, which is central in
  `P`; the ambient group is `P`);
* `exists_central_order_p`: a non-trivial finite `p`-group has a central
  element of order `p`, so `P₀ ≠ 1` (the book's "`P₀` is a non-trivial
  central elementary abelian `p`-subgroup of `P`"); it uses mathlib's
  `IsPGroup.center_nontrivial` and Cauchy's theorem.

Notation: the ambient group `G` of the Lean statements is the book's `P`;
`A` and `Z` are the book's `A` and `P₀` (elementary abelian means here:
commuting elements with `x^p = 1`).  Not covered: the `H`-invariance of
`P₀` (it is characteristic in `P`), the conical contractibility and
Quillen's Lemma; the statement that `A P₀` is elementary abelian is checked
for all elementary abelian `A ≤ P` and all `p`-subgroups `P` of the groups
of order at most 100 in `checks/sage/chapter-6a.py`.
-/

namespace BensonCohomology.CentralElementaryAbelian

variable {G : Type*} [Group G]

/-- The elements of `A ⊔ Z` commute when `A` is abelian and `Z` is central. -/
theorem sup_comm_of_central (A Z : Subgroup G)
    (hA : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a) (hZ : Z ≤ Subgroup.center G) :
    ∀ x ∈ A ⊔ Z, ∀ y ∈ A ⊔ Z, x * y = y * x := by
  -- every element of `A ∪ Z` centralises `A ⊔ Z`
  have hAc : A ≤ Subgroup.centralizer (A ⊔ Z : Subgroup G) := by
    intro a ha
    rw [Subgroup.mem_centralizer_iff]
    intro y hy
    -- `y` lies in the centraliser of `a`, which contains `A` and `Z`
    have hle : A ⊔ Z ≤ Subgroup.centralizer ({a} : Set G) := by
      refine sup_le (fun b hb => ?_) (fun z hz => ?_)
      · rw [Subgroup.mem_centralizer_iff]
        intro h hh
        rw [Set.mem_singleton_iff.mp hh]
        exact hA a ha b hb
      · rw [Subgroup.mem_centralizer_iff]
        intro h hh
        rw [Set.mem_singleton_iff.mp hh]
        exact ((Subgroup.mem_center_iff.mp (hZ hz)) a)
    have := Subgroup.mem_centralizer_iff.mp (hle hy) a (Set.mem_singleton a)
    exact this.symm
  have hZc : Z ≤ Subgroup.centralizer (A ⊔ Z : Subgroup G) := by
    intro z hz
    rw [Subgroup.mem_centralizer_iff]
    intro y _
    exact (Subgroup.mem_center_iff.mp (hZ hz)) y
  have hsup : A ⊔ Z ≤ Subgroup.centralizer (A ⊔ Z : Subgroup G) := sup_le hAc hZc
  intro x hx y hy
  exact (Subgroup.mem_centralizer_iff.mp (hsup hy) x hx)

/-- If moreover `a^p = 1` on `A` and `z^p = 1` on `Z`, then `x^p = 1` on `A ⊔ Z`. -/
theorem sup_pow_eq_one_of_central (p : ℕ) (A Z : Subgroup G)
    (hA : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a) (hAp : ∀ a ∈ A, a ^ p = 1)
    (hZ : Z ≤ Subgroup.center G) (hZp : ∀ z ∈ Z, z ^ p = 1) :
    ∀ x ∈ A ⊔ Z, x ^ p = 1 := by
  have hcomm := sup_comm_of_central A Z hA hZ
  -- the elements of `A ⊔ Z` with `x^p = 1` form a subgroup
  let T : Subgroup G :=
    { carrier := {x | x ∈ A ⊔ Z ∧ x ^ p = 1}
      mul_mem' := by
        rintro x y ⟨hx, hxp⟩ ⟨hy, hyp⟩
        refine ⟨(A ⊔ Z).mul_mem hx hy, ?_⟩
        have hc : Commute x y := hcomm x hx y hy
        rw [hc.mul_pow, hxp, hyp, one_mul]
      one_mem' := ⟨(A ⊔ Z).one_mem, one_pow p⟩
      inv_mem' := by
        rintro x ⟨hx, hxp⟩
        exact ⟨(A ⊔ Z).inv_mem hx, by rw [inv_pow, hxp, inv_one]⟩ }
  have hle : A ⊔ Z ≤ T := sup_le (fun a ha => ⟨Subgroup.mem_sup_left ha, hAp a ha⟩)
    (fun z hz => ⟨Subgroup.mem_sup_right hz, hZp z hz⟩)
  intro x hx
  exact (hle hx).2

/-- **Theorem 6.6.1, proof**: `⟨A, P₀⟩` is elementary abelian. -/
theorem sup_elementaryAbelian (p : ℕ) (A Z : Subgroup G)
    (hA : ∀ a ∈ A, ∀ b ∈ A, a * b = b * a) (hAp : ∀ a ∈ A, a ^ p = 1)
    (hZ : Z ≤ Subgroup.center G) (hZp : ∀ z ∈ Z, z ^ p = 1) :
    (∀ x ∈ A ⊔ Z, ∀ y ∈ A ⊔ Z, x * y = y * x) ∧ (∀ x ∈ A ⊔ Z, x ^ p = 1) :=
  ⟨sup_comm_of_central A Z hA hZ, sup_pow_eq_one_of_central p A Z hA hAp hZ hZp⟩

/-- **`P₀ ≠ 1`**: a non-trivial finite `p`-group has a central element of order `p`. -/
theorem exists_central_order_p {p : ℕ} [hp : Fact p.Prime] [Finite G] [Nontrivial G]
    (hG : IsPGroup p G) : ∃ z ∈ Subgroup.center G, orderOf z = p := by
  have : Nontrivial (Subgroup.center G) := hG.center_nontrivial
  have hZ : IsPGroup p (Subgroup.center G) := hG.to_subgroup _
  have hdvd : p ∣ Nat.card (Subgroup.center G) := by
    obtain ⟨n, hn⟩ := hZ.exists_card_eq
    have h1 : 1 < Nat.card (Subgroup.center G) := Finite.one_lt_card
    rw [hn] at h1 ⊢
    have hn0 : n ≠ 0 := by
      rintro rfl
      simp at h1
    exact dvd_pow_self p hn0
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' p hdvd
  exact ⟨z, z.2, by rw [← hz, Subgroup.orderOf_coe]⟩

end BensonCohomology.CentralElementaryAbelian

#print axioms BensonCohomology.CentralElementaryAbelian.sup_elementaryAbelian
#print axioms BensonCohomology.CentralElementaryAbelian.exists_central_order_p
