import Mathlib.Algebra.Module.LinearMap.Basic
import Mathlib.Algebra.Module.BigOperators
import Mathlib.Tactic.Module

/-!
# The bracket on p. 183: `(g_r - 1) γ_i - (g_i - 1) γ_r`, an element of `Ω² k`

Benson, *Representations and Cohomology II*, Section 5.8, the proof that
the Bockstein commutes with restriction to cyclic shifted subgroups
(pp. 182–183, the paragraph before Theorem 5.8.3,
`th:rank-variety-equality`; it supports Lemma 5.8.2,
`lem:rank-variety-isomorphism`, and its Remark).  With `P_1` free on
`γ_1, …, γ_r`, `δ(γ_i) = g_i - 1` and `Ω² k = Ker δ`, the proof uses

`λ_r (g_r - 1)(∑_(i<r) λ_i γ_i) - (∑_(i<r) λ_i (g_i - 1)) λ_r γ_r
   = ∑_(i<r) λ_i λ_r [(g_r - 1) γ_i - (g_i - 1) γ_r] ∈ Ω² k`

(as corrected: the book prints the scalars `λ_r - 1`, `λ_i - 1` in place of
the group algebra elements `g_r - 1`, `g_i - 1` inside the bracket).

Formalised here over any commutative ring `R` (the book's `k E`) and any
`R`-module `M` (the book's `P_1`), with arbitrary elements `a i` (the book's
`g_i - 1`), scalars `lam i ∈ R` (the book's `λ_i ∈ k ⊆ k E`), vectors
`γ i ∈ M` and an `R`-linear `δ : M → R` with `δ (γ i) = a i`; the index
`j` plays the role of `r` and the finite set `s` that of `{1, …, r - 1}`:

* `bracket_identity`: the displayed identity;
* `delta_bracket`: `δ (a j • γ i - a i • γ j) = 0`, so every bracket (and
  hence the left-hand side, `delta_lhs`) lies in `Ker δ = Ω² k`.

Not covered: that `Ker δ` is generated by the `b_i` and `c_ij`, the
congruence `v^(p-1) (∑ λ_i γ_i) ≡ ∑ λ_i^p b_i` modulo `Rad(Ω² k)`, and the
cancellation of the two sums; these are checked symbolically in the
`λ_i` for `E = (ℤ/3)^2, (ℤ/3)^3, (ℤ/5)^2` in `checks/sage/chapter-5a.py`
(Section 5.8), where the printed bracket is refuted (its image under `δ`
is non-zero).
-/

namespace BensonCohomology.ShiftedBracket

open scoped BigOperators

variable {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
variable {ι : Type*}

theorem bracket_identity (s : Finset ι) (a lam : ι → R) (γ : ι → M) (j : ι) :
    lam j • a j • (∑ i ∈ s, lam i • γ i) -
        (∑ i ∈ s, lam i * a i) • (lam j • γ j) =
      ∑ i ∈ s, (lam i * lam j) • (a j • γ i - a i • γ j) := by
  rw [Finset.smul_sum, Finset.smul_sum, Finset.sum_smul,
    ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  module

theorem delta_bracket (a : ι → R) (γ : ι → M) (δ : M →ₗ[R] R)
    (hδ : ∀ i, δ (γ i) = a i) (i j : ι) :
    δ (a j • γ i - a i • γ j) = 0 := by
  rw [map_sub, map_smul, map_smul, hδ, hδ, smul_eq_mul, smul_eq_mul,
    mul_comm, sub_self]

theorem delta_lhs (s : Finset ι) (a lam : ι → R) (γ : ι → M) (j : ι)
    (δ : M →ₗ[R] R) (hδ : ∀ i, δ (γ i) = a i) :
    δ (lam j • a j • (∑ i ∈ s, lam i • γ i) -
        (∑ i ∈ s, lam i * a i) • (lam j • γ j)) = 0 := by
  rw [bracket_identity, map_sum]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [map_smul, delta_bracket a γ δ hδ, smul_zero]

end BensonCohomology.ShiftedBracket

#print axioms BensonCohomology.ShiftedBracket.bracket_identity
#print axioms BensonCohomology.ShiftedBracket.delta_bracket
#print axioms BensonCohomology.ShiftedBracket.delta_lhs
